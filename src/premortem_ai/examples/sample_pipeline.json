"""
sample_pipeline.py

Executable example for running the PreMortem AI pipeline end-to-end
using a canonical PipelineRequest and writing generated artifacts
to the output directory.

This file intentionally demonstrates:
- Strict input / output separation
- Deterministic pipeline execution
- Audit-friendly artifact persistence
- Zero coupling to domain internals
"""

from __future__ import annotations

import json
from pathlib import Path
from datetime import datetime

from premortem_ai.pipelines.run_pipeline import run_pipeline
from premortem_ai.models.pipeline_request import PipelineRequest
from premortem_ai.utils.logger import info


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

EXAMPLES_DIR = Path(__file__).parent
PROJECT_ROOT = EXAMPLES_DIR.parents[2]
OUTPUT_DIR = PROJECT_ROOT / "output"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _ensure_output_dir() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


def _timestamp() -> str:
    return datetime.utcnow().strftime("%Y%m%d_%H%M%S")


# ---------------------------------------------------------------------------
# Main execution
# ---------------------------------------------------------------------------

def main() -> None:
    info("Starting PreMortem AI sample pipeline execution")

    _ensure_output_dir()

    # -------------------- Load request --------------------

    request_path = EXAMPLES_DIR / "sample_pipeline.json"

    with request_path.open() as f:
        payload = json.load(f)

    request = PipelineRequest(**payload)

    # -------------------- Run pipeline --------------------

    context = run_pipeline(request)

    run_id = _timestamp()

    # -------------------- Persist outputs --------------------

    if context.risks:
        with open(OUTPUT_DIR / f"risks_{run_id}.json", "w") as f:
            json.dump(
                {rid: r.model_dump() for rid, r in context.risks.items()},
                f,
                indent=2,
            )

    if getattr(context, "themes", None):
        with open(OUTPUT_DIR / f"themes_{run_id}.json", "w") as f:
            json.dump(context.themes, f, indent=2)

    if getattr(context, "summary", None):
        with open(OUTPUT_DIR / f"summary_{run_id}.md", "w") as f:
            f.write(context.summary)

    # -------------------- Console summary --------------------

    print("\n================ PIPELINE COMPLETE ================")
    print(f"Run ID:            {run_id}")
    print(f"Project:           {request.project_description[:60]}...")
    print(f"Discovered risks:  {len(context.risks)}")
    print(f"Stages executed:   {list(context.stage_timings.keys())}")
    print("Artifacts written to:")
    print(f"  → {OUTPUT_DIR.resolve()}")
    print("===================================================\n")


if __name__ == "__main__":
    main()
