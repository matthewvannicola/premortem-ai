{
  "name": "PreMortem AI – Retry Pipeline",
  "description": "Retries a specific PreMortem AI pipeline step using exponential backoff and Pipedream component execution.",
  "trigger": {
    "type": "http",
    "name": "retry_request"
  },
  "steps": [
    {
      "name": "extract_retry_payload",
      "type": "code",
      "code": "// Validate incoming retry request\nconst failed = event.body?.failed_step;\nconst payload = event.body?.input_payload;\n\nif (!failed) throw new Error(\"Missing required field: failed_step\");\nif (!payload) throw new Error(\"Missing required field: input_payload\");\n\nreturn { failed_step: failed, input_payload: payload };"
    },

    {
      "name": "determine_route",
      "type": "code",
      "code": "// Map failed step to rerun target\nconst step = steps.extract_retry_payload.failed_step;\n\nconst VALID_STEPS = [\n  \"discovery\",\n  \"scoring\",\n  \"themes\",\n  \"mitigation\",\n  \"summary\",\n  \"final_report\"\n];\n\nif (!VALID_STEPS.includes(step)) {\n  throw new Error(`Unknown pipeline step: ${step}`);\n}\n\nreturn { rerun: step };"
    },

    {
      "name": "branch_step_type",
      "type": "branch",
      "branches": [
        {
          "name": "rerun_discovery",
          "condition": "{{steps.determine_route.rerun === 'discovery'}}",
          "steps": [
            {
              "name": "run_discovery_retry",
              "type": "component",
              "retry": {
                "count": 4,
                "delay": 500,
                "factor": 2
              },
              "component": "matthewvannicola/premortem-ai/pipedream/components/discovery",
              "props": {
                "project_description": "{{steps.extract_retry_payload.input_payload.project_description}}"
              }
            }
          ]
        },
        {
          "name": "rerun_scoring",
          "condition": "{{steps.determine_route.rerun === 'scoring'}}",
          "steps": [
            {
              "name": "run_scoring_retry",
              "type": "component",
              "retry": {
                "count": 4,
                "delay": 500,
                "factor": 2
              },
              "component": "matthewvannicola/premortem-ai/pipedream/components/scoring",
              "props": {
                "risks": "{{steps.extract_retry_payload.input_payload.risks}}"
              }
            }
          ]
        },
        {
          "name": "rerun_themes",
          "condition": "{{steps.determine_route.rerun === 'themes'}}",
          "steps": [
            {
              "name": "run_themes_retry",
              "type": "component",
              "retry": {
                "count": 4,
                "delay": 500,
                "factor": 2
              },
              "component": "matthewvannicola/premortem-ai/pipedream/components/themes",
              "props": {
                "risks": "{{steps.extract_retry_payload.input_payload.risks}}"
              }
            }
          ]
        },
        {
          "name": "rerun_mitigation",
          "condition": "{{steps.determine_route.rerun === 'mitigation'}}",
          "steps": [
            {
              "name": "run_mitigation_retry",
              "type": "component",
              "retry": {
                "count": 4,
                "delay": 500,
                "factor": 2
              },
              "component": "matthewvannicola/premortem-ai/pipedream/components/mitigation",
              "props": {
                "risks": "{{steps.extract_retry_payload.input_payload.risks}}"
              }
            }
          ]
        },
        {
          "name": "rerun_summary",
          "condition": "{{steps.determine_route.rerun === 'summary'}}",
          "steps":
