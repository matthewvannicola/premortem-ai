{
  "name": "PreMortem AI – Main Pipeline",
  "description": "End-to-end automated pre-mortem analysis: discovery → scoring → themes → mitigations → summary → final report.",
  "trigger": {
    "type": "http"
  },
  "steps": [
    {
      "name": "extract_project_description",
      "type": "code",
      "params": {},
      "code": "// Extract project description from HTTP body\nreturn {\n  project_description: event.body.project_description\n};"
    },
    {
      "name": "risk_discovery",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/discovery",
      "props": {
        "project_description": "{{steps.extract_project_description.project_description}}"
      }
    },
    {
      "name": "risk_scoring",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/scoring",
      "props": {
        "risks": "{{steps.risk_discovery}}"
      }
    },
    {
      "name": "risk_themes",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/themes",
      "props": {
        "risks": "{{steps.risk_scoring}}"
      }
    },
    {
      "name": "risk_mitigations",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/mitigation",
      "props": {
        "risks": "{{steps.risk_scoring}}"
      }
    },
    {
      "name": "executive_summary",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/summary",
      "props": {
        "risks": "{{steps.risk_scoring}}"
      }
    },
    {
      "name": "final_report",
      "type": "component",
      "component": "matthewvannicola/premortem-ai/pipedream/components/final_report",
      "props": {
        "risks": "{{steps.risk_scoring}}",
        "themes": "{{steps.risk_themes}}",
        "mitigations": "{{steps.risk_mitigations}}",
        "summary": "{{steps.executive_summary}}"
      }
    },
    {
      "name": "respond",
      "type": "code",
      "params": {},
      "code": "// Return complete PreMortem AI pipeline results\nreturn {\n  project_description: steps.extract_project_description.project_description,\n  discovered_risks: steps.risk_discovery,\n  scored_risks: steps.risk_scoring,\n  themes: steps.risk_themes,\n  mitigations: steps.risk_mitigations,\n  summary: steps.executive_summary,\n  final_report: steps.final_report\n};"
    }
  ]
}
